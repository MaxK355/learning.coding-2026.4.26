}
document.getElementById('bSlider').oninput = drawBlocks;

/* ---------- final formula ---------- */
function ffRun(){
  let x = document.getElementById('ffIn').value.replace(/\D/g,'') || '1';
  const big = has2plus(x), s = big ? squash(x) : x;
  const b = BigInt('0b'+s), ans = ((big?1n:0n) + b + b/2n);
  let h = `<p>x = <span class="mono">${x}</span></p>`;
  h += big ? `<p>Has a digit ≥ 2 → squash: <span class="mono">${s}</span> &nbsp; <span class="badge b-par">+1</span></p>`
           : `<p>Already only 0/1 → no squash &nbsp; <span class="badge b-par">+0</span></p>`;
  h += `<p>b = <span class="mono">${s}</span>₂ = <b>${b}</b>, ⌊b/2⌋ = <b>${b/2n}</b></p>`;
  h += `<p class="big">answer = ${big?1:0} + ${b} + ${b/2n} = <b style="color:var(--acc)">${ans}</b>`
     + (ans >= MOD ? ` ≡ <b style="color:var(--acc)">${ans % MOD}</b> (mod 10⁹+7)` : '') + '</p>';
  if (x.length <= 7) { let s2=strip0(x), n=0; while(s2!=='0'){ s2=f(s2).v; n++; } h += `<p class="muted">Brute-force check: ${n} steps ✓</p>`; }
  document.getElementById('ffOut').innerHTML = h;
}

/* ---------- Horner ---------- */
let hoS, hoI, hoB, hoH;
function hoReset(){
  const x = document.getElementById('hoIn').value.replace(/\D/g,'') || '1';
  hoS = has2plus(x) ? squash(x) : x; hoI = 0; hoB = 0n; hoH = 0n;
  hoDraw();
  document.getElementById('hoTable').innerHTML = '<tr><th>i</th><th>bit</th><th>b = 2b+bit</th><th>half (skip last)</th></tr>';
}
function hoDraw(){
  document.getElementById('hoDigits').innerHTML = [...hoS].map((c,i)=>
    `<div class="d ${i<hoI?(c==='1'?'o':'e'):(i===hoI?'':'dim')}" style="${i===hoI?'outline:3px solid var(--acc)':''}">${c}</div>`).join('');
}
function hoStep(){
  if (hoI >= hoS.length) return;
  const bit = BigInt(hoS[hoI]), last = hoI === hoS.length-1;
  if (!last) hoH = (hoH*2n + bit) % MOD;
  hoB = (hoB*2n + bit) % MOD;
  document.getElementById('hoTable').insertAdjacentHTML('beforeend',
    `<tr><td>${hoI}</td><td>${bit}</td><td class="mono">${hoB}</td><td class="mono">${last?'<span class="muted">(skip) </span>':''}${hoH}</td></tr>`);
  hoI++; hoDraw();
}

