function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function hiLite(line){
  let code = line, cm = '';
  const k = line.indexOf('//'); if (k >= 0) { code = line.slice(0,k); cm = line.slice(k); }
  let h = esc(code)
    .replace(/('(?:\\.|[^'])')/g,'<span class="st">$1</span>')
    .replace(/\b(int|long|bool|char|string|size_t|const|auto)\b/g,'<span class="ty">$1</span>')
    .replace(/\b(for|if|while|return|using|namespace|true|false)\b/g,'<span class="kw">$1</span>')
    .replace(/(#include)/,'<span class="kw">$1</span>')
    .replace(/\b(\d+(?:LL)?)\b/g,'<span class="nu">$1</span>');
  return h + (cm ? `<span class="cm">${esc(cm)}</span>` : '');
}
function hlCode(tag){
  document.getElementById('codeBox').innerHTML = CODE.map(([t,l]) =>
    tag && t===tag ? `<span class="hlLine">${hiLite(l)||' '}</span>` : hiLite(l)).join('\n');
}

