<script>
const MOD = 1000000007n;
const sleep = ms => window.__dry ? Promise.resolve() : new Promise(r => setTimeout(r, ms));
if (new URLSearchParams(location.search).get('dry')) window.__dry = true;
const has2plus = s => /[2-9]/.test(s);
const squash = s => s.replace(/./g, c => (+c % 2) ? '1' : '0');
const strip0 = s => s.replace(/^0+(?=.)/, '');
function f(s){ return has2plus(s) ? {v: strip0(squash(s)), r:'A'} : {v: (BigInt(s)-1n).toString(), r:'B'}; }

function digitsHTML(s, cls){
  return '<div class="digits">' + [...s].map((c,i)=>`<div class="d ${cls?cls(c,i):''}">${c}</div>`).join('') + '</div>';
}

/* ---------- slide navigation ---------- */
const slides = [...document.querySelectorAll('.slide')];
const names = ['Title','Step 1 · Rules','Step 1 · Simulator','Step 1 · Why it\'s hard','Step 2 · 0/1 world','Step 2 · Binary countdown','Step 2 · Counting','Step 2 · Formula','Step 2 · Big numbers','Step 3 · Code','Summary'];
let cur = 0;
const dots = document.getElementById('dots');
slides.forEach((_,i)=>{ const d=document.createElement('span'); d.onclick=()=>go(i); dots.appendChild(d); });
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>go(+t.dataset.go));
function go(i){
  cur = Math.max(0, Math.min(slides.length-1, i));
  slides.forEach((s,k)=>s.classList.toggle('on', k===cur));
  [...dots.children].forEach((d,k)=>d.classList.toggle('on', k===cur));
  document.querySelectorAll('.tab').forEach(t=>{
    const g=+t.dataset.go; t.classList.toggle('on', (g===1&&cur>=1&&cur<4)||(g===4&&cur>=4&&cur<9)||(g===9&&cur>=9));
  });
  document.getElementById('slideLabel').textContent = `${cur+1}/${slides.length} · ${names[cur]}`;
  onEnter[cur] && onEnter[cur]();
}
document.addEventListener('keydown', e=>{
  if (e.target.tagName==='INPUT' && e.target.type==='text') return;
  if (e.key==='ArrowRight' || e.key==='PageDown') go(cur+1);
  if (e.key==='ArrowLeft' || e.key==='PageUp') go(cur-1);
});

/* ---------- title ---------- */
async function animTitle(){
  const el = document.getElementById('titleDigits');
  let s = '210';
  el.innerHTML = digitsHTML(s);
  for (let k=0;k<4;k++){ await sleep(900); if(cur!==0) return; s=f(s).v; el.innerHTML = digitsHTML(s); }
}

/* ---------- rule A / B ---------- */
async function animRuleA(){
  const el = document.getElementById('ruleA'), s='24135';
  el.innerHTML = digitsHTML(s);
  await sleep(700);
  el.innerHTML = digitsHTML(s, c=> +c%2?'o':'e');
  await sleep(900);
  el.innerHTML = digitsHTML(s, c=> +c%2?'o':'e') + '<div class="arrow">↓</div>' + digitsHTML(squash(s), c=> c==='1'?'o':'e')
     + '<p class="muted">24135 → 00101 = 101</p>';
}
async function animRuleB(){
  const el = document.getElementById('ruleB');
  el.innerHTML = digitsHTML('110') ;
  await sleep(900);
  el.innerHTML = digitsHTML('110') + '<div class="arrow">↓ −1</div>' + digitsHTML('109', c=>c==='9'?'nine':'')
     + '<p class="muted">110 → 109 (a 9 appears — so the next step will be Rule A)</p>';
}

/* ---------- simulator ---------- */
let simS, simN, simRows;
function simLoad(v){ document.getElementById('simIn').value=v; simReset(); }
function simReset(){
  simS = strip0(document.getElementById('simIn').value.replace(/\D/g,'') || '1');
  simN = 0;
  document.getElementById('simTable').innerHTML = '<tr><th>#</th><th>rule</th><th>value</th></tr><tr><td>0</td><td>start</td><td class="mono">'+simS+'</td></tr>';
  simDraw('');
}
function simDraw(note){
  document.getElementById('simCur').innerHTML = digitsHTML(simS, c => /[01]/.test(c)? '' : 'nine');
  document.getElementById('simNote').textContent = note;
  document.getElementById('simCount').textContent = simN;
}
function simStep(){
  if (simS === '0') { simDraw('Reached 0 — done!'); return false; }
  const before = simS, r = f(simS);
  simS = r.v; simN++;
  const badge = r.r==='A' ? '<span class="badge b-par">A · parity</span>' : '<span class="badge b-min">B · −1</span>';
  const t = document.getElementById('simTable');
  t.insertAdjacentHTML('beforeend', `<tr><td>${simN}</td><td>${badge}</td><td class="mono">${simS}</td></tr>`);
  t.parentElement.scrollTop = 1e9;
  simDraw(r.r==='A' ? `${before} has a digit ≥ 2 → parity squash` : `${before} is all 0/1 → subtract 1`);
  return simS !== '0';
}
async function simRun(){ for (let i=0;i<400 && simStep();i++) await sleep(250); }

/* ---------- growth table ---------- */
function fastCount(s){
  let a = 0n; if (has2plus(s)){ s = squash(s); a = 1n; }
  const b = BigInt('0b'+s); return a + b + b/2n;
}
function buildGrow(){
  const ex = ['9','99','999','9999','99999','999999999','99999999999999999999','9'.repeat(60)];
  let h = '<tr><th>x</th><th>digits</th><th>steps to reach 0</th></tr>';
  for (const s of ex) h += `<tr><td class="mono">${s.length>20?s.slice(0,8)+'…'+s.slice(-4):s}</td><td>${s.length}</td><td class="mono">${fastCount(s).toLocaleString()}</td></tr>`;
  document.getElementById('growTable').innerHTML = h;
}

/* ---------- insight 1 cases ---------- */
async function animCases(){
  const c1 = document.getElementById('case1'), c2 = document.getElementById('case2');
  const A = '1011', B='10100';
  c1.innerHTML = digitsHTML(A, (c,i)=> i===A.length-1?'o':'');
  c2.innerHTML = digitsHTML(B, (c,i)=> i>=2?'e':'');
  await sleep(1000);
  c1.innerHTML += '<div class="arrow">↓ −1</div>' + digitsHTML('1010', (c,i)=> i===3?'o':'');
  c2.innerHTML += '<div class="arrow">↓ −1 (borrow!)</div>' + digitsHTML('10099', (c,i)=> i>=3?'nine':(i===2?'e':''));
  await sleep(1200);
  c2.innerHTML += '<div class="arrow">↓ parity (9 is odd → 1)</div>' + digitsHTML('10011', (c,i)=> i>=3?'o':(i===2?'e':''));
}

/* ---------- binary countdown ---------- */
let bcS, bcTot;
function bcReset(){
  let v = document.getElementById('bcIn').value.replace(/\D/g,'') || '1';
  if (has2plus(v)) { v = strip0(squash(v)); document.getElementById('bcIn').value = v; }
  bcS = strip0(v); bcTot = 0;
  document.getElementById('bcTable').innerHTML = '<tr><th>decimal steps</th><th>binary b</th><th>cost</th><th>total</th></tr>'
    + `<tr><td class="mono">${bcS}</td><td class="mono">${BigInt('0b'+bcS)}</td><td></td><td>0</td></tr>`;
  document.getElementById('bcTotal').textContent = 0;
}
function bcStep(){
  if (bcS === '0') return false;
  const b = BigInt('0b'+bcS);
  let path, cost;
  if (bcS.endsWith('1')) { const n = strip0((BigInt(bcS)-1n).toString()); path = `${bcS} → ${n}`; bcS = n; cost = 1; }
  else { const m = (BigInt(bcS)-1n).toString(); const n = strip0(squash(m)); path = `${bcS} → <span style="color:var(--red)">${m}</span> → ${n}`; bcS = n; cost = 2; }
  bcTot += cost;
  const t = document.getElementById('bcTable');
  t.insertAdjacentHTML('beforeend', `<tr><td class="mono">${path}</td><td class="mono">${b} → ${b-1n}</td><td><span class="badge b-${cost}">+${cost}</span></td><td>${bcTot}</td></tr>`);
  t.parentElement.scrollTop = 1e9;
  document.getElementById('bcTotal').textContent = bcTot;
  return bcS !== '0';
}
async function bcRunAll(){ for (let i=0;i<300 && bcStep();i++) await sleep(300); }

/* ---------- counting blocks ---------- */
function drawBlocks(){
  const b = +document.getElementById('bSlider').value;
  document.getElementById('bVal').textContent = b;
  let h = '';
  for (let v=b; v>=1; v--){
    const odd = v%2===1;
